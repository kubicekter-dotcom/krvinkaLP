{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "krvinka.cz"
        }
      ],
      "destination": "https://www.krvinka.cz/$1",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/o-autorce.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/kontakt.html",
      "permanent": true
    },
    {
      "source": "/checkout.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-account.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shopping-cart.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/single-product.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/slider-fullscreen.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/slider-fullwidth.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/3d-parallax.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/second-header.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/third-header.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
